# Python / 环境
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 密钥与本地配置
.env
.env.*
*.key
# 各家 API Key 文件（.dashscope_key / .voyage_key / …）
pipeline/.*_key
pipeline/.dashscope_key

# 虚拟环境
.venv/
venv/
pipeline/.venv_rag/

# 向量库、索引产物与备份
pipeline/qdrant_data/
pipeline/index_artifacts/
pipeline/backups/

# 第三方语料(版权内容不进入公开仓库)
pipeline/corpus/*.pdf
pipeline/corpus/*.md
!pipeline/corpus/README.md

# 原始实验输出(可能包含第三方文档长文本)
pipeline/experiments/*.txt
pipeline/experiments/**/*.txt
pipeline/experiments/*
!pipeline/experiments/README.md
!pipeline/experiments/findings/
pipeline/experiments/findings/*
!pipeline/experiments/findings/README.md
!pipeline/experiments/findings/*.md

# PDF 解析过程日志
pipeline/corpus/*.log
pipeline/corpus/*.log.err
pipeline/corpus/*.err

# 服务日志
pipeline/server.log
pipeline/server.log.bak.*
pipeline/server_phase0.log
pipeline/server.err

# Agent 工作区(本地记忆与临时状态, 不进入仓库)
.workbuddy-ai/
pipeline/server.err

# 与本项目无关的嵌套仓库
hello_agent_demo/

# 评估运行产物(每次跑都会新增, 不入库)
pipeline/eval/runs/

# 重建期产物(与 experiments/ 同性质: 含第三方文档长文本)
pipeline/experiments_rebuilt/
pipeline/index_artifacts/phase0_rebuilt/

# playwright-cli 运行状态
.playwright-cli/

# 重建/扫描期产物(与 experiments/ 同性质: 含第三方文档长文本)
pipeline/experiments_final/
pipeline/experiments_rebuilt*/
pipeline/experiments_sweep/
pipeline/rebuilt_strip*/
pipeline/rebuilt_*/
pipeline/scan_chunk_tokens.json
pipeline/sweep_chunk_params.json
pipeline/sweep_ranking.json
pipeline/sweep_ranking_*.json

# 抓取的第三方文档(版权内容, 不入公开仓库)
docs/url_doc_*.html
docs/url_doc_*.json
# pipeline/docs/ 里只排除抓取的第三方文档, 自己的分析文档要入库
pipeline/docs/url_doc_*
docs/pipeline_flow.html
